# fwknop test suite runtime artifacts (generated by test-fwknop.pl) —
# sources (tests/*.pl, conf/*.conf, fko-wrapper/*.c) are tracked, these are not.

# test run output / state
output/
output.last/
run/
init

# logs from test runs
*.log

# temp files created by individual tests
*.tmp
too_long.args
local_hmac_spa.key

# GPG keyrings + access-include dir generated at runtime by the GPG tests
conf/client-gpg/
conf/client-gpg-no-pw/
conf/client-gpg-large-no-pw/
conf/client-gpg-subkeys-no-pw/
conf/server-gpg/
conf/server-gpg-no-pw/
conf/server-gpg-large-no-pw/
conf/server-gpg-subkeys-no-pw/
conf/server-gpg-client-large-no-pw/
conf/access-include/

# fko-wrapper build artifacts (sources are tracked)
fko-wrapper/fko_basic
fko-wrapper/fko_wrapper
fko-wrapper/cmd.out
